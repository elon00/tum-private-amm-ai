      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "TUM Munich",
        "PROJECT_TICKER": "TUMPAMM"
      },
      "tools": [
        {
          "name": "verify_tumpamm_invariants",
          "description": "Verifies deterministic invariants for TUM Private AMM AI on TUM Munich."
        },
        {
          "name": "execute_tumpamm_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}